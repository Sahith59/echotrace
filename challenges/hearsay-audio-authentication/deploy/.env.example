# Copy to deploy/.env and fill in. Never commit deploy/.env.

# --- Reverse proxy (read by docker compose and Caddy) ---
# Bare hostname, no scheme. Its DNS A record must point at the server's public IP.
ECHOTRACE_DOMAIN=echotrace.example.tech

# --- Required application settings ---
# Public origin, https, no trailing slash. Matches ECHOTRACE_DOMAIN on a single VM;
# in the Vercel layout it is the Vercel domain (https://<domain>).
ECHOTRACE_PUBLIC_URL=https://echotrace.example.tech
# Vercel layout only: the API hostname Vercel forwards /api/* to (bare, comma-separated).
# ECHOTRACE_DOMAIN is then this API hostname, and ECHOTRACE_PUBLIC_URL is the Vercel domain.
ECHOTRACE_ALLOWED_HOSTS=
# Require sign-in for all non-public API routes.
ECHOTRACE_AUTH=required
# Trust X-Forwarded-* from Caddy (the only thing that can reach the app container).
ECHOTRACE_TRUST_PROXY=1
# Container paths; docker-compose.yml also pins these. Do not change.
ECHOTRACE_WORKSPACE=/data/workspace
ECHOTRACE_STATIC_ROOT=/srv/static

# --- Google sign-in (optional; without both values Google sign-in is unavailable) ---
# Redirect URI to register: https://<domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Groq AI interpretation (optional) ---
GROQ_API_KEY=
# Defaults to openai/gpt-oss-120b (hosted by Groq) when empty.
ECHOTRACE_LLM_MODEL=

# --- Limits (optional) ---
# Per-user stored recording cap; app default is 500. Leave commented unless
# setting a number: an empty value makes the app fail at startup.
# ECHOTRACE_MAX_RECORDINGS_PER_USER=100

# --- Optional models installed on boot (downloaded once into the data volume) ---
# 1 = install the pinned WavLM speaker-comparison model if missing.
ECHOTRACE_INSTALL_SPEAKER=0
# 1 = install the faster-whisper transcription model if missing.
ECHOTRACE_INSTALL_WHISPER=0
# Whisper model name used for install and transcription; default base.
ECHOTRACE_WHISPER_MODEL=base
# CPU threads for transcription; default 4. Set to 2 on a 2-OCPU VM.
ECHOTRACE_WHISPER_CPU_THREADS=2
